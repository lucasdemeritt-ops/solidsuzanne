#version 450

// VGEO GPU Frustum Culling Compute Shader
// Performs frustum culling, backface culling via normal cones,
// LOD selection, and generates indirect draw commands

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Data Structures
// ============================================================================

// Bounding sphere for frustum culling (16 bytes, aligned)
struct BoundingSphere {
    vec3 center;
    float radius;
};

// Normal cone for backface culling (packed into 4 bytes as int)
// axis: snorm8 x3, cos_angle: snorm8
// Unpacked: vec3 axis (normalized), float cos_angle

// Cluster info for LOD and meshlet data
struct ClusterInfo {
    uint meshlet_start;
    uint meshlet_count;
    float error;           // World-space geometric error
    float parent_error;    // Parent's error (for LOD cut determination)
};

// Indirect draw command (matches VkDrawIndexedIndirectCommand)
struct IndirectDrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

// ============================================================================
// Descriptor Bindings
// ============================================================================

// Binding 0: Bounding spheres (readonly)
layout(std430, binding = 0) readonly buffer BoundsBuffer {
    vec4 bounds[];  // xyz = center, w = radius
};

// Binding 1: Normal cones (readonly, packed as int32)
layout(std430, binding = 1) readonly buffer ConesBuffer {
    int packed_cones[];  // Packed: axis.x|axis.y|axis.z|cos_angle (snorm8 each)
};

// Binding 2: Cluster info (readonly)
layout(std430, binding = 2) readonly buffer ClusterBuffer {
    ClusterInfo clusters[];
};

// Binding 3: Visible cluster indices (writeonly)
layout(std430, binding = 3) writeonly buffer VisibleBuffer {
    uint visible_indices[];
};

// Binding 4: Visible count (atomic)
layout(std430, binding = 4) buffer CountBuffer {
    uint visible_count;
};

// Binding 5: Indirect draw commands (writeonly)
layout(std430, binding = 5) writeonly buffer IndirectBuffer {
    IndirectDrawCommand indirect_commands[];
};

// Binding 6: HZB texture for occlusion culling (optional)
layout(binding = 6) uniform sampler2D hzb_texture;

// ============================================================================
// Push Constants
// ============================================================================

layout(push_constant) uniform PushConstants {
    vec4 frustum_planes[6];  // (nx, ny, nz, d) - normal pointing inward
    vec3 camera_pos;
    float error_threshold;   // Screen-space error threshold in pixels
    uint cluster_count;
    float screen_height;     // Screen height in pixels
    float cot_half_fov;      // cot(fov/2) for perspective projection
    uint _padding;
} pc;

// ============================================================================
// Helper Functions
// ============================================================================

// Unpack normal cone from packed int32
void unpack_cone(int packed, out vec3 axis, out float cos_angle) {
    // Extract signed bytes
    int ax = (packed >> 0) & 0xFF;
    int ay = (packed >> 8) & 0xFF;
    int az = (packed >> 16) & 0xFF;
    int ca = (packed >> 24) & 0xFF;

    // Convert from unsigned [0,255] to signed [-128,127]
    if (ax > 127) ax -= 256;
    if (ay > 127) ay -= 256;
    if (az > 127) az -= 256;
    if (ca > 127) ca -= 256;

    // Normalize from snorm8 [-127,127] to [-1,1]
    axis.x = float(ax) / 127.0;
    axis.y = float(ay) / 127.0;
    axis.z = float(az) / 127.0;
    cos_angle = float(ca) / 127.0;

    // Re-normalize axis (may be slightly off due to quantization)
    float len = length(axis);
    if (len > 0.001) {
        axis /= len;
    }
}

// Test if a sphere is visible within the frustum
bool is_sphere_in_frustum(vec3 center, float radius) {
    for (int i = 0; i < 6; i++) {
        // Signed distance from sphere center to plane
        float dist = dot(pc.frustum_planes[i].xyz, center) + pc.frustum_planes[i].w;

        // If sphere is completely outside this plane, cull it
        if (dist < -radius) {
            return false;
        }
    }
    return true;
}

// Test backface culling using normal cone
// Returns true if the cluster might have visible triangles
bool is_cone_visible(vec3 cone_axis, float cone_cos_angle, vec3 cluster_center, float radius) {
    // Direction from cluster center to camera
    vec3 to_camera = pc.camera_pos - cluster_center;
    float dist = length(to_camera);
    if (dist < 1e-6) {
        return true;  // Camera inside the cluster
    }
    vec3 view_dir = to_camera / dist;

    // All triangle normals lie within half-angle a of cone_axis, where
    // cone_cos_angle = cos(a). Every normal faces away from the camera iff
    // dot(view_dir, axis) < -sin(a), NOT -cos(a): using -cos(a) culls
    // clusters with half-angle > 45 deg that still contain front-facing
    // triangles. The radius/dist term keeps the test conservative for
    // normals attached anywhere on the bounding sphere (meshoptimizer's
    // convention).
    float sin_a = sqrt(max(0.0, 1.0 - cone_cos_angle * cone_cos_angle));
    return dot(view_dir, cone_axis) > -(sin_a + radius / dist);
}

// Compute screen-space error for LOD selection
float compute_screen_error(float world_error, float distance) {
    if (distance < 0.001) {
        return 10000.0;  // Very close, always select highest detail
    }

    // Project world-space error to screen-space pixels
    // screen_error = (world_error / distance) * cot(fov/2) * screen_height * 0.5
    return (world_error / distance) * pc.cot_half_fov * pc.screen_height * 0.5;
}

// Optional: Occlusion culling using HZB
bool is_occluded(vec3 center, float radius) {
    // TODO: Implement HZB-based occlusion culling
    // This would:
    // 1. Project bounding sphere to screen space
    // 2. Compute the appropriate mip level based on projected size
    // 3. Sample HZB at sphere corners
    // 4. Compare max sampled depth with sphere's near depth

    // For now, always return false (not occluded)
    return false;
}

// ============================================================================
// Main Entry Point
// ============================================================================

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Bounds check
    if (idx >= pc.cluster_count) {
        return;
    }

    // Load bounding sphere
    vec4 bound = bounds[idx];
    vec3 center = bound.xyz;
    float radius = bound.w;

    // Load cluster info
    ClusterInfo cluster = clusters[idx];

    // Skip if cluster has no meshlets
    if (cluster.meshlet_count == 0) {
        return;
    }

    // ========================================================================
    // Frustum Culling
    // ========================================================================
    if (!is_sphere_in_frustum(center, radius)) {
        return;
    }

    // ========================================================================
    // Normal Cone Backface Culling
    // ========================================================================
    int packed_cone = packed_cones[idx];
    vec3 cone_axis;
    float cone_cos_angle;
    unpack_cone(packed_cone, cone_axis, cone_cos_angle);

    // Only cull if the cone has valid data (cos_angle != 1.0, which means 180 degree cone = no culling)
    if (cone_cos_angle < 0.99) {
        if (!is_cone_visible(cone_axis, cone_cos_angle, center, radius)) {
            return;  // Entire cluster is backfacing
        }
    }

    // ========================================================================
    // LOD Selection (Screen-space Error)
    // ========================================================================
    float distance = length(center - pc.camera_pos);
    float screen_error = compute_screen_error(cluster.error, distance);

    // For Nanite-style DAG traversal, we would check:
    // - If screen_error < threshold AND parent's error > threshold, select this cluster
    // - This ensures we select clusters at the appropriate "cut" level

    // Simplified version: just check if screen error is below threshold
    // A more complete implementation would do full DAG traversal
    if (screen_error > pc.error_threshold && cluster.parent_error > 0.0) {
        // This cluster's error is too high, but it has a parent
        // In a full implementation, we'd traverse up to find the right level
        // For now, we accept it anyway (parent traversal would be in a separate pass)
    }

    // ========================================================================
    // Occlusion Culling (Optional)
    // ========================================================================
    // Uncomment when HZB is fully implemented:
    // if (is_occluded(center, radius)) {
    //     return;
    // }

    // ========================================================================
    // Output: Add to visible list
    // ========================================================================

    // Atomically get a slot in the visible list
    uint slot = atomicAdd(visible_count, 1);

    // Write visible cluster index
    visible_indices[slot] = idx;

    // Generate indirect draw command for this cluster's meshlets
    // Note: In a more sophisticated system, you might generate one command
    // per meshlet or use mesh shaders
    IndirectDrawCommand cmd;
    cmd.index_count = cluster.meshlet_count * 126 * 3;  // Approximate: 126 triangles per meshlet max
    cmd.instance_count = 1;
    cmd.first_index = cluster.meshlet_start * 126 * 3;  // Corresponding index offset
    cmd.vertex_offset = 0;
    cmd.first_instance = idx;  // Pass cluster ID through instance ID for debugging

    indirect_commands[slot] = cmd;
}
