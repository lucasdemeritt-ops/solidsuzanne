#version 450

// VGEO HZB (Hierarchical Z-Buffer) Generation Compute Shader
// Generates a mip-chain pyramid from depth buffer for occlusion culling

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input: Previous mip level (or depth buffer for mip 0)
layout(binding = 0) uniform sampler2D input_depth;

// Output: Current mip level being generated
layout(binding = 1, r32f) writeonly uniform image2D output_mip;

// Push constants for mip generation
layout(push_constant) uniform PushConstants {
    uvec2 output_size;     // Size of the output mip level
    uvec2 input_size;      // Size of the input (previous mip or depth buffer)
    uint mip_level;        // Current mip level being generated
    uint is_first_mip;     // 1 if copying from depth buffer, 0 if from previous HZB mip
    uint _padding[2];
} pc;

void main() {
    uvec2 pos = gl_GlobalInvocationID.xy;

    // Bounds check
    if (pos.x >= pc.output_size.x || pos.y >= pc.output_size.y) {
        return;
    }

    // Calculate UV coordinates for sampling
    // Each output texel corresponds to a 2x2 region in the input
    vec2 uv = (vec2(pos) + 0.5) / vec2(pc.output_size);

    // Sample 2x2 region from input
    // Use textureGather for efficiency (samples 4 texels at once)
    vec4 samples;

    if (pc.is_first_mip == 1) {
        // First mip: sample from depth buffer
        // Note: Depth buffer may be in different format, handle accordingly
        vec2 texel_size = 1.0 / vec2(pc.input_size);
        vec2 base_uv = uv - texel_size * 0.5;

        // Sample 4 corners of the 2x2 region
        samples.x = texture(input_depth, base_uv).r;
        samples.y = texture(input_depth, base_uv + vec2(texel_size.x, 0.0)).r;
        samples.z = texture(input_depth, base_uv + vec2(0.0, texel_size.y)).r;
        samples.w = texture(input_depth, base_uv + texel_size).r;
    } else {
        // Subsequent mips: sample from previous HZB mip
        // Use textureGather to get 2x2 block efficiently
        samples = textureGather(input_depth, uv, 0);  // Component 0 (red channel)
    }

    // For occlusion culling, we want the MAXIMUM depth in the region
    // This is conservative: if the max depth is less than an occluder,
    // then all pixels in that region are definitely occluded
    // Note: Using reversed-Z (near=1, far=0), so max becomes min conceptually

    // For standard depth (near=0, far=1):
    float max_depth = max(max(samples.x, samples.y), max(samples.z, samples.w));

    // Write to output mip level
    imageStore(output_mip, ivec2(pos), vec4(max_depth, 0.0, 0.0, 0.0));
}
