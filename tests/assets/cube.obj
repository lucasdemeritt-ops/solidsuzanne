# Unit cube centered at origin (corners at +/-0.5)
# 8 positions, 6 face normals, 4 UVs, 6 quad faces (fan-triangulated -> 12 tris)
# Per-face normals make all 24 face-corners unique after dedup.
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
f 4/1/1 3/2/1 2/3/1 1/4/1
f 5/1/2 6/2/2 7/3/2 8/4/2
f 1/1/3 4/2/3 8/3/3 5/4/3
f 6/1/4 2/2/4 3/3/4 7/4/4
f 1/1/5 5/2/5 6/3/5 2/4/5
f 4/1/6 8/2/6 7/3/6 3/4/6
